// ============================================================
// VI-FLEET
// Vehicle Intelligence: Fleet Management for Organizations
//
// ORM: Prisma
// Database: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  SYSTEM_ADMINISTRATOR
  ORGANIZATION_ADMINISTRATOR
  VICE_ORGANIZATION_ADMINISTRATOR
  TRANSPORT_MANAGER
  VICE_TRANSPORT_MANAGER
  DEPARTMENT_USER
  DRIVER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleType {
  BUILT_IN
  CUSTOM
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum RoleScopeAllowed {
  ORGANIZATION_ONLY
  DEPARTMENT_ONLY
  ORGANIZATION_OR_DEPARTMENT
}

enum RoleAssignmentStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  REVOKED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum VehicleAvailability {
  AVAILABLE
  ASSIGNED
  UNAVAILABLE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransportationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GPSDeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
}

enum GeofenceStatus {
  ACTIVE
  INACTIVE
}

enum GeofenceEventType {
  ENTRY
  EXIT
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum TripInterruptionReportStatus {
  PENDING_REVIEW
  IN_REVIEW
  RESOLVED
}

enum TripInterruptionCategory {
  VEHICLE_BREAKDOWN
  ACCIDENT_OR_INCIDENT
  ROAD_BLOCKED
  WEATHER_CONDITIONS
  DRIVER_UNAVAILABLE
  PASSENGER_OR_CARGO_ISSUE
  OTHER
}

enum TripInterruptionDecision {
  RESUME
  REASSIGN
  CANCEL
  COMPLETE
}

enum TripCompletionOutcome {
  SUCCESSFUL
  COMPLETED_WITH_ISSUES
  NOT_COMPLETED
}

enum TripCompletionReviewStatus {
  PENDING_REVIEW
  APPROVED
  NEEDS_CLARIFICATION
}

enum TripEvidenceType {
  START_ODOMETER_PHOTO
  COMPLETION_ODOMETER_PHOTO
  OTHER
}

enum OrganizationApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OrganizationType {
  PRIVATE_COMPANY
  GOVERNMENT
  NGO
  OTHER
}

enum OrganizationPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DepartmentUserApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StageApprovalPolicy {
  ANY_ONE
  ALL
}

enum StageApproverType {
  USER
  ROLE
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum StageInstanceStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
  REQUEST_CHANGES
  SKIP
}

enum WorkflowEventType {
  WORKFLOW_CREATED
  WORKFLOW_UPDATED
  VERSION_CREATED
  VERSION_PUBLISHED
  VERSION_ARCHIVED
  INSTANCE_STARTED
  STAGE_ENTERED
  DECISION_RECORDED
  STAGE_COMPLETED
  STAGE_SKIPPED
  CHANGES_REQUESTED
  REQUEST_RESUBMITTED
  INSTANCE_APPROVED
  INSTANCE_REJECTED
  INSTANCE_CANCELLED
}

// ============================================================
// ORGANIZATION
// ============================================================

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(150)
  description String?
  status      OrganizationStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  code         String? @unique @db.VarChar(20)
  contactEmail String? @map("contact_email") @db.VarChar(255)
  phone        String? @db.VarChar(30)

  organizationType   OrganizationType?
  website            String?            @db.VarChar(255)

  country            String?            @db.VarChar(100)
  region             String?            @db.VarChar(100)
  city               String?            @db.VarChar(100)
  streetAddress      String?            @db.VarChar(255)

  departmentCount    Int?
  estimatedFleetSize String?             @db.VarChar(50)

  departments                 Department[]
  users                       User[]
  roles                       OrganizationRole[]
  rolePermissions             RolePermission[]
  userRoleAssignments         UserRoleAssignment[]
  vehicles                    Vehicle[]
  drivers                     Driver[]
  transportationRequests      TransportationRequest[]
  trips                       Trip[]
  gpsDevices                  GPSDevice[]
  gpsLocations                GPSLocation[]
  geofences                   Geofence[]
  geofenceEvents              GeofenceEvent[]
  maintenanceRecords          MaintenanceRecord[]
  maintenanceSchedules        MaintenanceSchedule[]
  fuelRecords                 FuelRecord[]
  alerts                      Alert[]
  departmentRegistrationLinks DepartmentRegistrationLink[]
  departmentUserApplications  DepartmentUserApplication[]

  tripStatusHistories           TripStatusHistory[]
  tripInterruptionReports       TripInterruptionReport[]
  tripCompletionReports         TripCompletionReport[]
  tripEvidence                  TripEvidence[]
  tripCompletionReportRevisions TripCompletionReportRevision[]

  approvalWorkflows             ApprovalWorkflow[]
  approvalWorkflowVersions      ApprovalWorkflowVersion[]
  approvalWorkflowStages        ApprovalWorkflowStage[]
  approvalStageApprovers        ApprovalStageApprover[]
  approvalWorkflowInstances     ApprovalWorkflowInstance[]
  approvalStageInstances        ApprovalStageInstance[]
  approvalDecisions             ApprovalDecision[]
  approvalWorkflowEvents        ApprovalWorkflowEvent[]

  application OrganizationApplication?

  @@map("organizations")
}

// ============================================================
// ORGANIZATION_APPLICATION
// ============================================================

model OrganizationApplication {
  id               String  @id @default(uuid()) @db.Uuid
  organizationName String  @map("organization_name") @db.VarChar(150)
  contactEmail     String  @map("contact_email") @db.VarChar(255)
  phone            String? @db.VarChar(30)
  description      String?

  organizationType   OrganizationType?
  website            String?            @db.VarChar(255)

  country            String?            @db.VarChar(100)
  region             String?            @db.VarChar(100)
  city               String?            @db.VarChar(100)
  streetAddress      String?            @db.VarChar(255)

  departmentCount    Int?
  estimatedFleetSize String?             @db.VarChar(50)

  officialDocumentKey      String? @db.VarChar(500)
  officialDocumentFileName String? @db.VarChar(255)
  officialDocumentMimeType String? @db.VarChar(100)
  officialDocumentSize     Int?

  status        OrganizationApplicationStatus @default(PENDING)
  paymentStatus OrganizationPaymentStatus     @default(NOT_REQUIRED) @map("payment_status")

  reviewNotes String? @map("review_notes")

  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)

  organizationId String? @unique @map("organization_id") @db.Uuid

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewedBy   User?         @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, submittedAt])
  @@index([contactEmail])
  @@index([reviewedById])
  @@map("organization_applications")
}

// ============================================================
// ORGANIZATION_iNVITATION
// ============================================================

model OrganizationInvitation {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User @relation("InvitationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdById])
  @@map("organization_invitations")
}

// ============================================================
// DEPARTMENT USER REGISTRATION LINK
// ============================================================

model DepartmentRegistrationLink {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  createdById    String @map("created_by_id") @db.Uuid

  tokenHash      String  @unique @map("token_hash") @db.VarChar(255)
  tokenEncrypted String? @map("token_encrypted") @db.Text

  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("DepartmentRegistrationLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([createdById])
  @@map("department_registration_links")
}

// ============================================================
// DEPARTMENT USER APPLICATION
// ============================================================

model DepartmentUserApplication {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  departmentId   String @map("department_id") @db.Uuid

  firstName  String  @map("first_name") @db.VarChar(150)
  middleName String  @map("middle_name") @db.VarChar(150)
  lastName   String  @map("last_name") @db.VarChar(150)
  email      String  @db.VarChar(255)
  phone      String? @db.VarChar(30)

  status DepartmentUserApplicationStatus @default(PENDING)

  reviewNotes  String?   @map("review_notes")
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)

  createdUserId String? @map("created_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  reviewedBy   User?        @relation("DepartmentUserApplicationReviewedBy", fields: [organizationId, reviewedById], references: [organizationId, id], onDelete: Restrict)
  createdUser  User?        @relation("DepartmentUserApplicationCreatedUser", fields: [organizationId, createdUserId], references: [organizationId, id], onDelete: Restrict)

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, createdUserId])
  @@index([organizationId, status, submittedAt])
  @@index([organizationId, departmentId])
  @@index([organizationId, email])
  @@index([reviewedById])
  @@map("department_user_applications")
}

// ============================================================
// DEPARTMENT
// ============================================================

model Department {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name        String           @db.VarChar(100)
  description String?
  status      DepartmentStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users                      User[]
  userRoleAssignments        UserRoleAssignment[]
  transportationRequests     TransportationRequest[]
  departmentUserApplications DepartmentUserApplication[]
  approvalWorkflowInstances  ApprovalWorkflowInstance[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("departments")
}

// ============================================================
// USER
// ============================================================

model User {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  departmentId   String? @map("department_id") @db.Uuid

  firstName  String? @map("first_name") @db.VarChar(150)
  middleName String? @map("middle_name") @db.VarChar(150)
  lastName   String? @map("last_name") @db.VarChar(150)
  email      String? @db.VarChar(255)

  pendingEmail      String? @map("pending_email") @db.VarChar(255)
  passwordHash      String? @map("password_hash")
  phone             String? @db.VarChar(30)
  profilePictureUrl String? @map("profile_picture_url")

  role   UserRole
  status UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  department Department? @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)

  driver Driver?

  emailVerificationTokens EmailVerificationToken[]
  submittedRequests       TransportationRequest[]  @relation("RequestedBy")
  reviewedRequests        TransportationRequest[]  @relation("ReviewedBy")

  createdGeofences Geofence[] @relation("GeofenceCreatedBy")

  createdRoles      OrganizationRole[]   @relation("CreatedRoles")
  roleAssignments   UserRoleAssignment[] @relation("UserAssignments")
  assignedUserRoles UserRoleAssignment[] @relation("AssignmentsAssignedBy")
  revokedUserRoles  UserRoleAssignment[] @relation("AssignmentsRevokedBy")

  reviewedApplications OrganizationApplication[] @relation("ApplicationReviewedBy")
  receivedInvitations  OrganizationInvitation[]  @relation("InvitationRecipient")
  createdInvitations   OrganizationInvitation[]  @relation("InvitationCreatedBy")

  createdDepartmentRegistrationLinks DepartmentRegistrationLink[] @relation("DepartmentRegistrationLinkCreatedBy")
  reviewedDepartmentUserApplications DepartmentUserApplication[]  @relation("DepartmentUserApplicationReviewedBy")
  createdDepartmentUserApplication   DepartmentUserApplication?   @relation("DepartmentUserApplicationCreatedUser")

  passwordResetTokens PasswordResetToken[]

  changedTripStatuses       TripStatusHistory[]      @relation("TripStatusChangedBy")
  reviewedTripInterruptions TripInterruptionReport[] @relation("TripInterruptionReviewedBy")
  reviewedTripCompletions   TripCompletionReport[]   @relation("TripCompletionReviewedBy")
  uploadedTripEvidence      TripEvidence[]           @relation("TripEvidenceUploadedBy")

  createdApprovalWorkflows   ApprovalWorkflow[]        @relation("CreatedApprovalWorkflows")
  publishedWorkflowVersions  ApprovalWorkflowVersion[] @relation("PublishedWorkflowVersions")
  stageApproverAssignments   ApprovalStageApprover[]   @relation("StageApproverUser")
  requestedWorkflowInstances ApprovalWorkflowInstance[] @relation("InstanceRequester")
  cancelledWorkflowInstances ApprovalWorkflowInstance[] @relation("InstanceCancelledBy")
  approvalDecisions          ApprovalDecision[]        @relation("ApprovalDecisions")
  approvalWorkflowEvents     ApprovalWorkflowEvent[]   @relation("WorkflowEventActor")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, role])
  @@index([departmentId])
  @@map("users")
}

// ============================================================
// PERMISSION
// ============================================================

model Permission {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(100)
  name           String   @db.VarChar(150)
  description    String?
  category       String   @db.VarChar(100)
  isPlatformOnly Boolean  @default(false) @map("is_platform_only")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

// ============================================================
// ORGANIZATION ROLE
// ============================================================

model OrganizationRole {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(150)
  slug           String           @db.VarChar(100)
  description    String?
  roleType       RoleType         @default(CUSTOM) @map("role_type")
  status         RoleStatus       @default(ACTIVE)
  scopeAllowed   RoleScopeAllowed @default(ORGANIZATION_ONLY) @map("scope_allowed")
  isSystemRole   Boolean          @default(false) @map("is_system_role")
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("CreatedRoles", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]
  stageApproverAssignments ApprovalStageApprover[] @relation("StageApproverRole")

  @@unique([organizationId, id])
  @@index([organizationId, slug])
  @@index([organizationId, status])
  @@index([createdById])
  @@map("organization_roles")
}

// ============================================================
// ROLE PERMISSION
// ============================================================

model RolePermission {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permissionId   String   @map("permission_id") @db.Uuid
  isBaseline     Boolean  @default(false) @map("is_baseline")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         OrganizationRole @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([organizationId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================
// USER ROLE ASSIGNMENT
// ============================================================

model UserRoleAssignment {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  roleId           String               @map("role_id") @db.Uuid
  departmentId     String?              @map("department_id") @db.Uuid
  status           RoleAssignmentStatus @default(ACTIVE)
  assignedById     String?              @map("assigned_by_id") @db.Uuid
  assignedAt       DateTime             @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedById      String?              @map("revoked_by_id") @db.Uuid
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?              @map("revocation_reason")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User             @relation("UserAssignments", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  role         OrganizationRole @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  department   Department?      @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  assignedBy   User?            @relation("AssignmentsAssignedBy", fields: [organizationId, assignedById], references: [organizationId, id], onDelete: Restrict)
  revokedBy    User?            @relation("AssignmentsRevokedBy", fields: [organizationId, revokedById], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, userId])
  @@index([organizationId, roleId])
  @@index([organizationId, departmentId])
  @@index([userId, status])
  @@index([assignedById])
  @@index([revokedById])
  @@map("user_role_assignments")
}

// ============================================================
// VEHICLE
// ============================================================

model Vehicle {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  registrationNumber String  @map("registration_number") @db.VarChar(50)
  vin                String? @db.VarChar(17)

  make        String? @db.VarChar(100)
  model       String? @db.VarChar(100)
  year        Int?
  color       String? @db.VarChar(50)
  vehicleType String? @map("vehicle_type") @db.VarChar(100)

  status       VehicleStatus       @default(ACTIVE)
  availability VehicleAvailability @default(AVAILABLE)

  fuelType        String?  @map("fuel_type") @db.VarChar(50)
  seatingCapacity Int?     @map("seating_capacity")
  currentOdometer Decimal? @map("current_odometer") @db.Decimal(12, 2)

  notes String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  preferredDrivers     Driver[]              @relation("DriverPreferredVehicle")
  trips                Trip[]
  gpsDevices           GPSDevice[]
  gpsLocations         GPSLocation[]
  geofenceEvents       GeofenceEvent[]
  maintenanceRecords   MaintenanceRecord[]
  maintenanceSchedules MaintenanceSchedule[]
  fuelRecords          FuelRecord[]
  alerts               Alert[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, availability])
  @@map("vehicles")
}

// ============================================================
// DRIVER
// ============================================================

model Driver {
  id                 String  @id @default(uuid()) @db.Uuid
  organizationId     String  @map("organization_id") @db.Uuid
  userId             String? @map("user_id") @db.Uuid
  preferredVehicleId String? @map("preferred_vehicle_id") @db.Uuid

  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  phone             String?   @db.VarChar(30)
  licenseNumber     String    @map("license_number") @db.VarChar(100)
  licenseExpiryDate DateTime? @map("license_expiry_date") @db.Date

  status DriverStatus @default(ACTIVE)

  notes String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  user User? @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  preferredVehicle Vehicle? @relation("DriverPreferredVehicle", fields: [organizationId, preferredVehicleId], references: [organizationId, id], onDelete: Restrict)

  trips  Trip[]
  alerts Alert[]

  interruptionReports       TripInterruptionReport[]       @relation("TripInterruptionReportedBy")
  completionReports         TripCompletionReport[]         @relation("TripCompletionSubmittedBy")
  completionReportRevisions TripCompletionReportRevision[] @relation("TripCompletionRevisionSubmittedBy")

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, preferredVehicleId])
  @@map("drivers")
}

// ============================================================
// TRANSPORTATION REQUEST
// ============================================================

model TransportationRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

